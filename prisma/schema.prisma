// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceStatus {
  PLANNING
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Workspaces this user created — membership/roles for all workspaces live in Clerk Organizations,
  // not here, so this is just "who to blame/bill" rather than an access-control source of truth.
  createdWorkspaces Workspace[]
  agentPrompts      AgentPrompt[]
  memberships       WorkspaceMember[]
}

model Workspace {
  id          String          @id @default(cuid())
  name        String
  description String?
  creatorId   String
  // Clerk Organization id — the membership/role source of truth (org:admin, org:member,
  // org:viewer). One org can own many workspaces (not unique); nullable because a solo user's
  // personal workspace has no org behind it under Membership-optional mode.
  clerkOrgId  String?
  // Dashboard kanban column + order within it. position is a float so a dropped card can
  // take the midpoint between its neighbors — only the moved card ever gets written.
  status      WorkspaceStatus @default(PLANNING)
  position    Float           @default(0)
  // Public read-only link token; null means sharing is off. Resetting it kills old links.
  shareToken  String?         @unique
  generation  Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  creator      User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  // Every workspace is always exactly one doc + one canvas, paired — not a generic list of
  // surfaces. Both are created alongside the workspace itself.
  doc          Doc?
  canvas       Canvas?
  agentPrompts AgentPrompt[]
  members      WorkspaceMember[]
  comments     WorkspaceComment[]
  snapshots    WorkspaceSnapshot[]
  tasks        WorkspaceTask[]

  @@index([creatorId])
  @@index([clerkOrgId])
}

model Doc {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  // BlockNote block JSON — a readable copy for server-side features (agent, share view).
  content     Json?
  // Yjs document state — the real-time collaboration source of truth.
  yjsState    Bytes?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Canvas {
  yjsState    Bytes?
  id          String   @id @default(cuid())
  workspaceId String   @unique
  // tldraw shape/store snapshot.
  content     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// One row per prompt a user sends to the agent, counted per owner each month for usage limits.
// Rows outlive their workspace (SetNull), so deleting a workspace can't reset usage.
model AgentPrompt {
  id          String   @id @default(cuid())
  // Who the prompt counts against: the workspace's Clerk org id, or the Clerk user id for a
  // personal workspace. Clerk prefixes ids ("org_", "user_"), so the two never collide.
  ownerId     String
  userId      String
  workspaceId String?
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
}

model WorkspaceMember {
  id          String @id @default(cuid())
  workspaceId String
  userId      String
  role        String @default("VIEWER")
  createdAt   DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceComment {
  id          String @id @default(cuid())
  workspaceId String
  authorId    String
  authorName  String
  body        String
  surface     String @default("WORKSPACE")
  anchorId    String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
}

model WorkspaceSnapshot {
  id          String @id @default(cuid())
  workspaceId String
  label       String
  authorName  String
  authorId    String?
  generation  Int
  docContent  Json?
  docState    Bytes?
  canvasContent Json?
  canvasState Bytes?
  tasks       Json?
  createdAt   DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
}

model WorkspaceTask {
  id          String @id @default(cuid())
  workspaceId String
  title       String
  description String @default("")
  phase       String @default("Implementation")
  status      String @default("TODO")
  sourceKey   String?
  position    Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, sourceKey])
  @@index([workspaceId, position])
}

model AccountDeletion {
  id              String @id @default(cuid())
  clerkId         String @unique
  tokenHash       String
  providerDeleted Boolean @default(false)
  createdAt       DateTime @default(now())
}

model UploadedAsset {
  filename    String @id
  ownerClerkId String
  createdAt   DateTime @default(now())
  @@index([ownerClerkId])
}
